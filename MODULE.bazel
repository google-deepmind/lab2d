http_archive(
    name = "tree_archive",
    build_file = "@//bazel:tree.BUILD",
    integrity = "sha256-2Jy0PzRltH3Sl6E1mr7/liKvAcdPCVNAvFwd/oWld2A=",
    strip_prefix = "tree-master",
